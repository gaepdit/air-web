@using AirWeb.AppServices.Compliance.Compliance.ComplianceMonitoring.Search
@using AirWeb.AppServices.Core.Search
@using AirWeb.WebApp.Pages.Shared.DisplayTemplates
@model IList<AirWeb.AppServices.Compliance.Compliance.ComplianceMonitoring.Search.ComplianceWorkSearchResultDto>
@{
    var searchSpec = (ISearchDto?)ViewData["SearchSpec"];
    var hideStaff = (bool?)ViewData["HideStaff"] ?? false;
    var hideFacility = (bool?)ViewData["HideFacility"] ?? false;
    var linkCss = searchSpec is null ? "fw-normal link-offset-1" : "btn btn-sm btn-outline-primary ms-1 ms-md-0";
}

<div class="table-responsive">
    <table class="table table-hover mb-0 table-collapsible" aria-label="Compliance Work results table">
        <thead>
        <tr class="@(searchSpec is null ? "" : "sortable")">
            @if (searchSpec is null)
            {
                <th scope="col" class="text-nowrap">Tracking #</th>
                <th scope="col" class="text-nowrap">Event Date</th>
                @if (!hideFacility)
                {
                    <th scope="col" class="text-nowrap">Facility</th>
                }

                <th scope="col" class="text-nowrap">Work Type</th>
            }
            else
            {
                <partial name="Shared/_SortableTableColHead" model="searchSpec" view-data="new ViewDataDictionary(ViewData)"
                         view-data-Heading="@("Tracking #")" view-data-Ascender="@nameof(ComplianceWorkSortBy.IdAsc)" view-data-Descender="@nameof(ComplianceWorkSortBy.IdDesc)" />
                <partial name="Shared/_SortableTableColHead" model="searchSpec" view-data="new ViewDataDictionary(ViewData)"
                         view-data-Heading="@("Event Date")" view-data-Ascender="@nameof(ComplianceWorkSortBy.EventDateAsc)" view-data-Descender="@nameof(ComplianceWorkSortBy.EventDateDesc)" />
                @if (!hideFacility)
                {
                    <partial name="Shared/_SortableTableColHead" model="searchSpec" view-data="new ViewDataDictionary(ViewData)"
                             view-data-Heading="@("Facility")" view-data-Ascender="@nameof(ComplianceWorkSortBy.FacilityIdAsc)" view-data-Descender="@nameof(ComplianceWorkSortBy.FacilityIdDesc)" />
                }

                <partial name="Shared/_SortableTableColHead" model="searchSpec" view-data="new ViewDataDictionary(ViewData)"
                         view-data-Heading="@("Work Type")" view-data-Ascender="@nameof(ComplianceWorkSortBy.WorkTypeAsc)" view-data-Descender="@nameof(ComplianceWorkSortBy.WorkTypeDesc)" />
            }
            <th scope="col" class="text-nowrap">Status</th>
            @if (!hideStaff)
            {
                <th scope="col" class="text-nowrap">Responsible Staff</th>
            }
        </tr>
        </thead>

        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <th scope="row" data-label="Tracking #">
                    <a asp-page="/Compliance/Work/Details" asp-route-id="@item.Id.ToString()"
                       class="@linkCss">@item.Id.ToString()</a>
                    @if (item.IsDeleted)
                    {
                        <span class="text-danger-emphasis">DELETED</span>
                    }
                </th>
                <td data-label="Event Date">
                    <span class="d-md-block">@item.EventDateName</span>
                    <span class="text-nowrap fst-italic">@Html.DisplayFor(_ => item.EventDate, DisplayTemplate.ShortDateOnly)</span>
                </td>
                @if (!hideFacility)
                {
                    <td data-label="Facility">
                        <span class="text-nowrap">@item.FacilityId</span>
                        <span class="d-md-block">@item.FacilityName</span>
                    </td>
                }
                <td data-label="Work Type">@item.ComplianceWorkType</td>
                <td class="text-nowrap" data-label="Status">
                    <span class="d-md-block">@Html.DisplayFor(_ => item.IsClosed, DisplayTemplate.BoolClosed)</span>
                    @if (item.IsClosed)
                    {
                        <span class="fst-italic">@Html.DisplayFor(_ => item.ClosedDate, DisplayTemplate.ShortDateOnlyNullable)</span>
                    }
                    @if (item.AdditionalDate is not null)
                    {
                        <span class="d-md-block mt-3">@item.AdditionalDateName</span>
                        <span class="fst-italic">@Html.DisplayFor(_ => item.AdditionalDate, DisplayTemplate.ShortDateOnlyNullable)</span>
                    }
                </td>
                @if (!hideStaff)
                {
                    <td data-label="Responsible Staff">@Html.DisplayFor(_ => item.ResponsibleStaff, DisplayTemplate.NameOrPlaceholder)</td>
                }
            </tr>
        }
        </tbody>
    </table>
</div>
