@page
@using AirWeb.WebApp.Pages.Shared.DisplayTemplates
@using AirWeb.Domain.Core.Entities
@model AccountIndexModel
@{
    ViewData["Title"] = "Account Profile";
}

<h1>@ViewData["Title"]</h1>
<hr />

<h2>
    @if (!Model.DisplayStaff.Active)
    {
        <em class="text-warning">Inactive:</em>
    }
    @Html.DisplayFor(m => m.DisplayStaff, DisplayTemplate.NameOrPlaceholder)
</h2>

<dl class="row">
    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Html.DisplayFor(m => m.DisplayStaff.Email, DisplayTemplate.TextOrPlaceholder)</dd>

    <dt class="col-sm-3">Phone</dt>
    <dd class="col-sm-9">@Html.DisplayFor(m => m.DisplayStaff.PhoneNumber, DisplayTemplate.TextOrPlaceholder,
                additionalViewData: new { Placeholder = DefaultText.PlaceholderNone })</dd>

    <dt class="col-sm-3">Office</dt>
    <dd class="col-sm-9">@Html.DisplayFor(m => m.OfficeName, DisplayTemplate.TextOrPlaceholder,
                additionalViewData: new { Placeholder = DefaultText.PlaceholderNone })</dd>
    
    <dt class="col-sm-3">Theme</dt>
    <dd class="col-sm-9">
        @Model.Preferences.Theme
    </dd>
</dl>

<form method = "post">

    <label class="form-label">Theme</label>

    <div class="btn-group" role="group" aria-label="Theme selection">

        <input class="btn-check"
               type="radio"
               name="theme"
               id="themeLight"
               value="@ThemePreference.Light"
               checked="@(Model.Preferences.Theme == ThemePreference.Light)" />
        
        <label class="btn btn-outline-secondary" for="themeLight">
            Light
        </label>

        <input class="btn-check"
               type="radio"
               name="theme"
               id="themeDark"
               value="@ThemePreference.Dark"
               checked="@(Model.Preferences.Theme == ThemePreference.Dark)" />
        
        <label class="btn btn-outline-secondary" for="themeDark">
            Dark
        </label>

        <input class="btn-check"
               type="radio"
               name="theme"
               id="themeAuto"
               value="@ThemePreference.Auto"
               checked="@(Model.Preferences.Theme == ThemePreference.Auto)" />
        
        <label class="btn btn-outline-secondary" for="themeAuto">
            Auto
        </label>
    </div>

    <button type="submit" class="btn btn-primary">
        Save THeme
    </button>

</form>

<div class="mb-3">
    @if (Model.DisplayStaff is { Active: true, Email: not null })
    {
        <a asp-page="Edit" class="btn btn-outline-primary me-2">Edit Profile</a>
    }
    <form class="d-inline-block" asp-page="Logout" method="post">
        <button type="submit" class="btn btn-danger">Sign out</button>
    </form>
</div>

<partial name="Shared/_UserRolesPartial" model="Model.Roles" />

<environment include="Local, Development">
    <details class="p-3 border rounded-3 bg-info-subtle">
        <summary class="rounded-1 p-1"><h3 class="h4 ps-1 m-0 no-anchor d-inline-block">Claims</h3></summary>

        <dl class="p-3">
            @foreach (var claim in Model.User.Claims)
            {
                <dt>@claim.Type</dt>
                <dd class="text-body-secondary">@claim.Value</dd>
            }
        </dl>
    </details>
</environment>
